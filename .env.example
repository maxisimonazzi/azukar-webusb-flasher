# Puerto web expuesto en localhost
WEB_PORT=9090

# Extensiones de archivos permitidas al importar proyectos desde un archivo ZIP (separadas por coma)
# .hex sirve para las ROM ($readmemh / icebram).
ALLOWED_IMPORT_EXTENSIONS=v,pcf,txt,hex

# Prefijo público donde se sirve la app. Vacío = raíz del dominio.
# Sin barra final. Entra al build (Vite + docroot de nginx): cambiarlo pide
# `docker compose up --build -d`. En el VPS: BASE_PATH=/grabador-lattice-webusb
BASE_PATH=
