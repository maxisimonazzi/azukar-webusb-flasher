# Puerto web expuesto en localhost. Solo aplica en local: en el VPS el overlay
# docker-compose.edge.yml borra el mapeo de puertos y la app se alcanza solo
# por la red Docker `edge`, desde Caddy.
WEB_PORT=9090

# Extensiones de archivos permitidas al importar proyectos desde un archivo ZIP (separadas por coma)
# .hex sirve para las ROM ($readmemh / icebram).
ALLOWED_IMPORT_EXTENSIONS=v,pcf,txt,hex

# Zona horaria de los contenedores. Es la que sale en el log de acceso de nginx.
# Los timestamps que agrega Docker con `logs -t` son siempre UTC y no dependen de esto.
TZ=America/Argentina/Tucuman

# Prefijo público donde se sirve la app. Vacío = raíz del dominio.
# Sin barra final. Entra al build (Vite + docroot de nginx): cambiarlo pide
# `docker compose up --build -d`. En el VPS: BASE_PATH=/grabador-lattice-webusb
BASE_PATH=
