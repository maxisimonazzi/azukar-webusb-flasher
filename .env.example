# Copiá a .env y ajustá. Compose lee esto al `up --build`.
# Cambiar COMPILE_BACKEND exige rebuild: docker compose up --build -d

# server = Yosys/nextpnr en el contenedor toolchain (rápido, nativo)
# yowasp = Yosys/nextpnr en el navegador (WASM)
COMPILE_BACKEND=yowasp

# Puerto de la SPA en esta PC (HTTP). En el VPS el overlay de Caddy no lo publica.
WEB_PORT=9090

# Solo VPS + docker-compose.caddy.yml. Dominio con A/AAAA a la IP del VPS.
# SITE_ADDRESS=flasher.tudominio.com
