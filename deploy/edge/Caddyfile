# Un sitio, varias apps. Caddy saca el certificado de Let's Encrypt solo
# (necesita 80 y 443 abiertos y el DNS ya apuntando al VPS) y rutea por path
# a contenedores que están en la red `edge` y no publican ningún puerto.
#
# El bloque global va primero y vale para todo el archivo.
{
	# Sin esto el log sale con la hora en epoch. `time_local` la pasa a la zona
	# del contenedor, que fija TZ en docker-compose.yml.
	log {
		format console {
			time_format "2006-01-02 15:04:05"
			time_local
		}
	}

	email maxisimonazzi@gmail.com
}

maxisimonazzi.com.ar {
	redir https://www.maxisimonazzi.com.ar{uri} permanent
}

www.maxisimonazzi.com.ar {
	encode zstd gzip

	# Grabador Lattice WebUSB. El alias `grabador-lattice` lo pone
	# docker-compose.edge.yml del repo lattice-webusb-flasher.
	# El path NO se recorta: la app está compilada con BASE_PATH y su nginx
	# sirve el árbol colgando de ese mismo prefijo.
	redir /grabador-lattice-webusb /grabador-lattice-webusb/ permanent
	handle /grabador-lattice-webusb/* {
		reverse_proxy grabador-lattice:80
	}

	# Landing de la raíz. Cuando exista, levantala con alias `landing` en la red
	# `edge` y reemplazá estos dos bloques por un solo: reverse_proxy landing:80
	#
	# `handle /` es match exacto: solo la raíz. Cualquier otra URL del dominio
	# cae en el `handle` sin matcher y contesta 404, para no devolver 200 en
	# rutas que no existen (los buscadores indexarían basura).
	handle / {
		respond "maxisimonazzi.com.ar - en obra. Por ahora: /grabador-lattice-webusb/" 200
	}

	handle {
		respond "No encontrado" 404
	}
}

# Herramienta nueva = un bloque más acá y un alias más en su compose:
#
#	redir /otra-herramienta /otra-herramienta/ permanent
#	handle /otra-herramienta/* {
#		reverse_proxy otra-herramienta:80
#	}

azukar.com.ar {
	redir https://www.azukar.com.ar{uri} permanent
}

www.azukar.com.ar {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	reverse_proxy azukar-toolbox:80
}

# Si algún día ponés Cloudflare en modo proxy (nubecita naranja), el origen deja
# de ver la IP del visitante: ve la de Cloudflare. Para que Caddy le crea al
# X-Forwarded-For hay que declarar los rangos de CF como proxies de confianza,
# en un bloque global arriba de todo:
#
# {
# 	servers {
# 		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 …
# 	}
# }
#
# Hoy no hace falta porque ambos dominios están en DNS-only. Antes de activar
# el proxy hay que coordinar Caddy, nginx, rate limits y el firewall; ver la
# documentación de producción de Azukar Toolbox.
# Lista actualizada: https://www.cloudflare.com/ips/
